{
  "name": "basil",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "preview": "vite preview",
    "start": "tsx server/index.ts",
    "assets": "python3 -I tools/extract.py && python3 -I tools/doors.py && python3 -I tools/basil.py && python3 -I tools/drawn.py && python3 -I tools/favicon.py",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "description": "A cosy pixel-art kitchen: type what you bought, watch it land on the shelves, and let Basil the cat tell you what you can cook.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  }
}
