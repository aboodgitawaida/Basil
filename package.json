{
  "name": "basil",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "preview": "vite preview",
    "start": "tsx server/index.ts",
    "assets": "python3 -I tools/extract.py && python3 -I tools/doors.py && python3 -I tools/basil.py && python3 -I tools/favicon.py",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "playwright": "^1.49.1",
    "tsx": "^4.19.2",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "^2.1.9"
  },
  "description": "A cosy pixel-art kitchen: type what you bought, watch it land on the shelves, and let Basil the cat tell you what you can cook.",
  "license": "MIT"
}
