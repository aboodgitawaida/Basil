# Which model provider to use: gemini (default) or groq.
# Everything else about the provider lives in server/config.ts.
BASIL_PROVIDER=gemini

# Key for whichever provider you picked. Read server-side only — it is never
# sent to the browser and never part of the bundle.
GEMINI_API_KEY=
# GROQ_API_KEY=

# Optional: pin a different model name without touching the code.
# BASIL_MODEL=gemini-flash-latest
